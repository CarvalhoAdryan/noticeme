{
  "expo": {
    "name": "NoticeME",
    "slug": "noticeme",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "noticeme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
